# ==========================================
# Rebuttal — Environment Configuration
# ==========================================

# Required: Your LLM API Key (Groq is recommended & free tier friendly)
# Get a free key at https://console.groq.com/keys
AI_API_KEY=gsk_your_groq_api_key_here

# Optional: Base URL for OpenAI-compatible completions
# Defaults to Groq: https://api.groq.com/openai/v1
# Can also be set to OpenAI (https://api.openai.com/v1), OpenRouter (https://openrouter.ai/api/v1), or Ollama (http://localhost:11434/v1)
AI_BASE_URL=https://api.groq.com/openai/v1

# Optional: Model name
# Defaults to Groq's high-speed frontier model: llama-3.3-70b-versatile
AI_MODEL=llama-3.3-70b-versatile
